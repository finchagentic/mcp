# Normalize all text files to LF in the repo, regardless of the checkout
# platform's line-ending settings. Without this, files edited on Windows
# (CRLF) show every line as changed in git diff even when only a few
# characters actually changed — makes review and blame useless.
* text=auto eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
